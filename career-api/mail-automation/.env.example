# Safe template for GitHub and deployment archives. Copy to .env and replace
# every placeholder with real values on your server. Never commit real secrets.
# cPanel environment variables take precedence; cPanel normally supplies PORT.
PORT=3000
HOST=0.0.0.0

# Must exactly match career-api/career-config.php -> mail_webhook_token.
CAREER_MAIL_WEBHOOK_TOKEN=replace-with-a-new-long-random-secret
CAREER_MAIL_WEBHOOK_URL=http://127.0.0.1:3000/career-submission

# SMTP details supplied by your email provider/cPanel Email Accounts page.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-a-new-app-password

# Sender and recipients.
MAIL_FROM_NAME=Sri Shakthi Careers
MAIL_FROM_EMAIL=no-reply@example.com
CAREER_HR_EMAIL=hr@example.com
CAREER_CC_EMAIL=

# Public URLs used inside the HTML email.
INSTITUTION_LOGO_URL=https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQLrUdm2N8eIhn1CqDrTwZX0vtRZ2qnXP1LGGt-y6f2TA&s
INSTITUTION_WEBSITE_URL=https://siet.ac.in
INSTITUTION_WEBSITE_LABEL=siet.ac.in
CAREER_RESUME_BASE_URL=https://siet.ac.in/webportal/resume

# Used only by npm run test:mail.
TEST_RECIPIENT_EMAIL=your-test-email@example.com
