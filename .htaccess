DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # The canonical SSSM route uses the same page rendered by the main SPA.
  RewriteRule ^sssm/?$ index.html [L]
  # Serve real compiled assets, images, downloads and documents directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send clean application routes back to the React entry point.
  RewriteRule ^ index.html [L]
</IfModule>


# SIET image caching: keep photos cached locally so repeat visits load faster.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  # The hosting account currently emits a restrictive default-src policy.
  # Add a specific frame-src exception for the embedded Vigoe AI assistant.
  # Apply to both normal and "always" response header tables used by Apache.
  Header edit* Content-Security-Policy "default-src 'self'" "default-src 'self'; frame-src 'self' https://vigoe.ai"
  Header always edit* Content-Security-Policy "default-src 'self'" "default-src 'self'; frame-src 'self' https://vigoe.ai"

  <FilesMatch "\.(avif|gif|jpe?g|png|svg|webp)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
