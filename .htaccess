# =============================================================================
# .htaccess — Security Hardening & SPA Routing for siet.ac.in
# Server: Apache + PHP + MySQL
# =============================================================================

Options -Indexes -ExecCGI -MultiViews
ServerSignature Off
DirectoryIndex index.html

# Fallback error documents
ErrorDocument 404 /index.html

# -----------------------------------------------------------------------------
# SECTION 1 — BLOCK CONFIRMED MALICIOUS IPs (from log analysis)
# -----------------------------------------------------------------------------
<RequireAll>
    Require all granted

    # --- Webshell probe IPs (Bangladesh / South Asia) ---
    Require not ip 103.77.107.132
    Require not ip 157.66.56.188
    Require not ip 103.65.237.158

    # --- High-volume scanner bots (Azure US, DigitalOcean, Psychz Networks) ---
    Require not ip 20.220.232.240
    Require not ip 172.93.212.236
    Require not ip 142.93.211.25
    Require not ip 52.169.148.186

    # --- Form flooding IPs ---
    Require not ip 91.103.248.60
    Require not ip 98.70.243.25
    Require not ip 137.59.47.47
    Require not ip 137.59.47.73
    Require not ip 147.45.79.175
    Require not ip 176.222.54.229
    Require not ip 45.135.3.205
    Require not ip 89.167.37.217
    Require not ip 179.61.129.188
    Require not ip 45.153.34.43
    Require not ip 149.102.225.182
    Require not ip 194.26.192.111
    Require not ip 141.98.11.17

    # --- Bulletproof / suspicious hosting ---
    Require not ip 51.79.128.217
    Require not ip 163.252.83.164
</RequireAll>

# -----------------------------------------------------------------------------
# SECTION 2 — BLOCK WEBSHELL & BACKDOOR PATHS
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block known webshell toolkit paths (case-insensitive)
    RewriteRule ^(.*)alfacgiapi(.*)$            - [F,L,NC]
    RewriteRule ^(.*)haxorcgiapi(.*)$           - [F,L,NC]
    RewriteRule ^(.*)rimurucgiapi(.*)$          - [F,L,NC]
    RewriteRule ^(.*)ALFA_DATA(.*)$             - [F,L,NC]
    RewriteRule ^(.*)LEVIATHAN(.*)$             - [F,L,NC]
    RewriteRule ^(.*)RIMURU(.*)$                - [F,L,NC]
    RewriteRule ^(.*)Escobar(.*)$               - [F,L,NC]
    RewriteRule ^(.*)1337_DATA(.*)$             - [F,L,NC]
    RewriteRule ^(.*)jancox(.*)$                - [F,L,NC]
    RewriteRule ^(.*)perl\.alfa(.*)$            - [F,L,NC]
    RewriteRule ^(.*)perl\.haxor(.*)$           - [F,L,NC]
    RewriteRule ^(.*)perl\.rimuru(.*)$          - [F,L,NC]

    # Block direct access to shell/script file extensions in upload dirs
    RewriteRule ^uploads/.*\.(php|phtml|php3|php4|php5|php7|phar|shtml|pl|cgi|sh)$ - [F,L,NC]
    RewriteRule ^images/.*\.(php|phtml|phar|pl|cgi|sh)$                            - [F,L,NC]
    RewriteRule ^img/.*\.(php|phtml|phar|pl|cgi|sh)$                               - [F,L,NC]

    # Block common WordPress exploit paths (probed even on non-WP sites)
    RewriteRule ^wp-admin/(.*)$                 - [F,L,NC]
    RewriteRule ^wp-content/(.*)$               - [F,L,NC]
    RewriteRule ^wp-includes/(.*)$              - [F,L,NC]
    RewriteRule ^xmlrpc\.php$                   - [F,L,NC]
    RewriteRule ^wp-login\.php$                 - [F,L,NC]

    # Block common PHP info / config exposure probes
    RewriteRule ^phpinfo\.php$                  - [F,L,NC]
    RewriteRule ^php-info\.php$                 - [F,L,NC]
    RewriteRule ^info\.php$                     - [F,L,NC]
    RewriteRule ^test\.php$                     - [F,L,NC]
    RewriteRule ^\.env$                         - [F,L,NC]
    RewriteRule ^\.git/(.*)$                    - [F,L,NC]
    RewriteRule ^config\.php$                   - [F,L,NC]
    RewriteRule ^configuration\.php$            - [F,L,NC]
    RewriteRule ^db\.php$                       - [F,L,NC]
    RewriteRule ^database\.php$                 - [F,L,NC]

    # Block path traversal attempts
    RewriteCond %{QUERY_STRING} (\.\./|\.\.%2F|%2E%2E%2F) [NC]
    RewriteRule .* - [F,L]

    # Block null byte injection
    RewriteCond %{QUERY_STRING} %00 [NC]
    RewriteRule .* - [F,L]

    # Block base64-encoded exploit payloads in query strings
    RewriteCond %{QUERY_STRING} (base64_encode|base64_decode)\s*\( [NC]
    RewriteRule .* - [F,L]

    # Block eval/exec injection in query strings
    RewriteCond %{QUERY_STRING} (eval\(|passthru\(|shell_exec\(|system\(|popen\(|proc_open\() [NC]
    RewriteRule .* - [F,L]

    # Block SQL injection patterns in query strings
    RewriteCond %{QUERY_STRING} (union(\s|%20)+(all(\s|%20)+)?select|information_schema|load_file\s*\() [NC,OR]
    RewriteCond %{QUERY_STRING} (sleep\s*\(\s*[0-9]|benchmark\s*\(|extractvalue\s*\() [NC]
    RewriteRule .* - [F,L]
</IfModule>

# -----------------------------------------------------------------------------
# SECTION 3 — BLOCK MALICIOUS & SCANNER USER AGENTS
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{HTTP_USER_AGENT} (zgrab|masscan|nuclei|sqlmap|nikto|nmap|dirbuster|gobuster|wfuzz|hydra|medusa) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (acunetix|nessus|openvas|burpsuite|havij|pangolin|whcc) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (python-requests|python-urllib|python-httpx|libwww-perl|LWP::) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (MJ12bot|AhrefsBot|SemrushBot|DotBot|PetalBot|coccocbot) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# -----------------------------------------------------------------------------
# SECTION 4 — PROTECT SENSITIVE FILES
# -----------------------------------------------------------------------------
<FilesMatch "\.(env|log|sql|sqlite|sqlite3|bak|backup|tar|gz|zip|htpasswd|htaccess|ini|cfg|conf|pem|key|crt|csr|pfx|p12|swp|swo|orig|old|tmp|cache)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(config|configuration|database|db|settings|wp-config|local|career-config)\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "error_log">
    Require all denied
</FilesMatch>

# -----------------------------------------------------------------------------
# SECTION 5 — HTTP SECURITY HEADERS
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set Cross-Origin-Resource-Policy "cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://ajax.googleapis.com https://maxcdn.bootstrapcdn.com https://www.googletagmanager.com https://connect.facebook.net https://static.cloudflareinsights.com https://secure.trust-provider.com https://vigoe.ai https://*.vigoe.ai; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://maxcdn.bootstrapcdn.com https://stackpath.bootstrapcdn.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com https://maxcdn.bootstrapcdn.com https://cdnjs.cloudflare.com data:; frame-src 'self' https://vigoe.ai https://*.vigoe.ai https://challenges.cloudflare.com blob:; connect-src 'self' https://vigoe.ai https://*.vigoe.ai; frame-ancestors 'self';"

    Header always unset X-Powered-By
    Header always unset Server

    # Image caching headers
    <FilesMatch "\.(avif|gif|jpe?g|png|svg|webp)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
# SECTION 6 — PREVENT PHP EXECUTION IN UPLOAD DIRECTORIES
# -----------------------------------------------------------------------------
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# -----------------------------------------------------------------------------
# SECTION 7 — REQUEST SIZE LIMITS
# -----------------------------------------------------------------------------
<IfModule mod_php.c>
    php_value upload_max_filesize 5M
    php_value post_max_size 8M
    php_value max_execution_time 30
    php_value max_input_time 30
    php_value memory_limit 128M
</IfModule>

LimitRequestBody 10485760

# -----------------------------------------------------------------------------
# SECTION 8 — PHP HANDLER FOR CPANEL
# -----------------------------------------------------------------------------
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
</IfModule>

# -----------------------------------------------------------------------------
# SECTION 9 — ROUTING & REACT SPA URL REWRITES
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # HTTPS enforcement (preserving ACME and cPanel validation tokens)
    RewriteCond %{HTTPS} off
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteCond %{REQUEST_URI} !^/\.well-known/cpanel-dcv/
    RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Specific microsite exceptions and downloads
    RewriteRule ^sssm/?$ /index.html [L]
    RewriteRule ^download/(.*)$ /downloads/$1 [R=302,L,NE]
    RewriteRule ^downloads/(CIA-II-semester-VII-UG-Rescheduled|CIA-II-semester-VII-UG|SIET-Brochure|sample-syllabus|Regulation-2021-UG)\.pdf$ /downloads/Regulation%202021%20UG.pdf [R=302,L,NE]
    RewriteRule ^downloads/Transcript-application-form\.pdf$ /downloads/Transcript%20application%20form.pdf [R=302,L,NE]
    RewriteRule ^downloads/Duplicate-Certificate-Form\.pdf$ /downloads/Duplicate%20Certificate%20Form.pdf [R=302,L,NE]
    RewriteRule ^downloads/Revaluation-form\.pdf$ /downloads/Revaluation%20form.pdf [R=302,L,NE]
    RewriteRule ^downloads/Revaluation-Script-Valuation-form\.pdf$ /downloads/Revaluation-Script%20Valuation%20form.pdf [R=302,L,NE]
    RewriteRule ^downloads/Regulation-2021-PG\.pdf$ /downloads/Regulation%202021%20PG.pdf [R=302,L,NE]
    RewriteRule ^downloads/R2021-UG-AMENDMENT-I\.pdf$ /downloads/R2021%20UG-AMENDMENT%20-%20I%20SIET.pdf [R=302,L,NE]
    RewriteRule ^downloads/R2021-UG-AMENDMENT-II\.pdf$ /downloads/R2021%20UG-AMENDMENT%20-%20II%20SIET.pdf [R=302,L,NE]

    # Pass through existing cPanel sub-apps if present
    RewriteRule ^(webportal|agrifest|media|kalam)($|/) - [L]

    # Stop rewriting if index.html is directly requested
    RewriteRule ^index\.html$ - [L]

    # Serve real files directly (CSS, JS, images, PDFs, PHP scripts like apply-submit.php, career-submit.php)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Serve real directories only if they contain an index.html file (e.g. /, /icchi/, /mdfi/)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^ - [L]

    # Send all clean frontend routes (e.g. /about, /careers, /admissions, /academics) to /index.html
    RewriteRule . /index.html [L]
</IfModule>
