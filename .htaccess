# =============================================================================
# .htaccess — Security Hardening for siet.ac.in
# Server: Apache + PHP + MySQL
# =============================================================================
# INSTRUCTIONS:
#   1. Place this file in your website root (public_html / www / htdocs)
#   2. Ensure mod_rewrite and mod_headers are enabled on your Apache server
#   3. Test in staging before deploying to production
#   4. Review the IP block list monthly and remove expired entries
# =============================================================================

Options -Indexes -ExecCGI
ServerSignature Off

# -----------------------------------------------------------------------------
# SECTION 1 — BLOCK CONFIRMED MALICIOUS IPs (from log analysis)
# -----------------------------------------------------------------------------
# These IPs were identified as high-volume attackers in the 19–20 Mar 2026 logs.
# Re-evaluate this list monthly — cloud IPs rotate.

<RequireAll>
    Require all granted

    # --- Webshell probe IPs (Bangladesh / South Asia) ---
    Require not ip 103.77.107.132
    Require not ip 157.66.56.188
    Require not ip 103.65.237.158

    # --- High-volume scanner bots (Azure US, DigitalOcean, Psychz Networks) ---
    Require not ip 20.220.232.240
    Require not ip 172.93.212.236
    Require not ip 142.93.211.25
    Require not ip 52.169.148.186

    # --- Form flooding IPs ---
    Require not ip 91.103.248.60
    Require not ip 98.70.243.25
    Require not ip 137.59.47.47
    Require not ip 137.59.47.73
    Require not ip 147.45.79.175
    Require not ip 176.222.54.229
    Require not ip 45.135.3.205
    Require not ip 89.167.37.217
    Require not ip 179.61.129.188
    Require not ip 45.153.34.43
    Require not ip 149.102.225.182
    Require not ip 194.26.192.111
    Require not ip 141.98.11.17

    # --- Bulletproof / suspicious hosting ---
    Require not ip 51.79.128.217
    Require not ip 163.252.83.164
</RequireAll>

# -----------------------------------------------------------------------------
# SECTION 2 — BLOCK WEBSHELL & BACKDOOR PATHS
# Patterns identified directly from your logs: ALFA, LEVIATHAN, RIMURU, Escobar
# These are known PHP webshell signatures. Block them before they hit PHP.
# -----------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block known webshell toolkit paths (case-insensitive)
    RewriteRule ^(.*)alfacgiapi(.*)$            - [F,L,NC]
    RewriteRule ^(.*)haxorcgiapi(.*)$           - [F,L,NC]
    RewriteRule ^(.*)rimurucgiapi(.*)$          - [F,L,NC]
    RewriteRule ^(.*)ALFA_DATA(.*)$             - [F,L,NC]
    RewriteRule ^(.*)LEVIATHAN(.*)$             - [F,L,NC]
    RewriteRule ^(.*)RIMURU(.*)$                - [F,L,NC]
    RewriteRule ^(.*)Escobar(.*)$               - [F,L,NC]
    RewriteRule ^(.*)1337_DATA(.*)$             - [F,L,NC]
    RewriteRule ^(.*)jancox(.*)$                - [F,L,NC]
    RewriteRule ^(.*)perl\.alfa(.*)$            - [F,L,NC]
    RewriteRule ^(.*)perl\.haxor(.*)$           - [F,L,NC]
    RewriteRule ^(.*)perl\.rimuru(.*)$          - [F,L,NC]

    # Block direct access to shell/script file extensions in upload dirs
    RewriteRule ^uploads/.*\.(php|phtml|php3|php4|php5|php7|phar|shtml|pl|cgi|sh)$ - [F,L,NC]
    RewriteRule ^images/.*\.(php|phtml|phar|pl|cgi|sh)$                            - [F,L,NC]
    RewriteRule ^img/.*\.(php|phtml|phar|pl|cgi|sh)$                               - [F,L,NC]

    # Block common WordPress exploit paths (probed even on non-WP sites)
    RewriteRule ^wp-admin/(.*)$                 - [F,L,NC]
    RewriteRule ^wp-content/(.*)$               - [F,L,NC]
    RewriteRule ^wp-includes/(.*)$              - [F,L,NC]
    RewriteRule ^xmlrpc\.php$                   - [F,L,NC]
    RewriteRule ^wp-login\.php$                 - [F,L,NC]

    # Block common PHP info / config exposure probes
    RewriteRule ^phpinfo\.php$                  - [F,L,NC]
    RewriteRule ^php-info\.php$                 - [F,L,NC]
    RewriteRule ^info\.php$                     - [F,L,NC]
    RewriteRule ^test\.php$                     - [F,L,NC]
    RewriteRule ^\.env$                         - [F,L,NC]
    RewriteRule ^\.git/(.*)$                    - [F,L,NC]
    RewriteRule ^config\.php$                   - [F,L,NC]
    RewriteRule ^configuration\.php$            - [F,L,NC]
    RewriteRule ^db\.php$                       - [F,L,NC]
    RewriteRule ^database\.php$                 - [F,L,NC]

    # Block path traversal attempts
    RewriteCond %{QUERY_STRING} (\.\./|\.\.%2F|%2E%2E%2F) [NC]
    RewriteRule .* - [F,L]

    # Block null byte injection
    RewriteCond %{QUERY_STRING} %00 [NC]
    RewriteRule .* - [F,L]

    # Block base64-encoded exploit payloads in query strings
    RewriteCond %{QUERY_STRING} (base64_encode|base64_decode)\s*\( [NC]
    RewriteRule .* - [F,L]

    # Block eval/exec injection in query strings
    RewriteCond %{QUERY_STRING} (eval\(|passthru\(|shell_exec\(|system\(|popen\(|proc_open\() [NC]
    RewriteRule .* - [F,L]

    # Block SQL injection patterns in query strings
    RewriteCond %{QUERY_STRING} (union(\s|%20)+(all(\s|%20)+)?select|information_schema|load_file\s*\() [NC,OR]
    RewriteCond %{QUERY_STRING} (sleep\s*\(\s*[0-9]|benchmark\s*\(|extractvalue\s*\() [NC]
    RewriteRule .* - [F,L]

    
</IfModule>

# -----------------------------------------------------------------------------
# SECTION 3 — BLOCK MALICIOUS & SCANNER USER AGENTS
# Automated scanners and exploit tools identified in the logs
# -----------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block known attack tools and scanners
    RewriteCond %{HTTP_USER_AGENT} (zgrab|masscan|nuclei|sqlmap|nikto|nmap|dirbuster|gobuster|wfuzz|hydra|medusa) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (acunetix|nessus|openvas|burpsuite|havij|pangolin|whcc) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (python-requests|python-urllib|python-httpx|libwww-perl|LWP::) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (curl\/[0-9]|Wget\/[0-9]) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (MJ12bot|AhrefsBot|SemrushBot|DotBot|PetalBot|coccocbot) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (^-$|^$) [NC]
    RewriteRule .* - [F,L]

    # Note: Googlebot and ClaudeBot appear in logs — they are legitimate crawlers.
    # If you want to block ALL bots including legitimate ones, add:
    #   RewriteCond %{HTTP_USER_AGENT} (bot|crawler|spider) [NC]
    # Not recommended unless under active DDoS.

</IfModule>

# -----------------------------------------------------------------------------
# SECTION 4 — PROTECT SENSITIVE FILES
# Prevent direct browser access to config, log, and database files
# -----------------------------------------------------------------------------

<FilesMatch "\.(env|log|sql|bak|backup|tar|gz|zip|htpasswd|htaccess|ini|cfg|conf|pem|key|crt|csr|pfx|p12|swp|swo|orig|old|tmp|cache)$">
    Require all denied
</FilesMatch>

# Protect PHP config files specifically
<FilesMatch "^(config|configuration|database|db|settings|wp-config|local)\.php$">
    Require all denied
</FilesMatch>

# Prevent access to hidden files/directories (dotfiles)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Prevent listing of directory contents
Options -Indexes

# Prevent access to PHP error logs if they land in webroot
<FilesMatch "error_log">
    Require all denied
</FilesMatch>

# -----------------------------------------------------------------------------
# SECTION 5 — HTTP SECURITY HEADERS
# Adds browser-level protections against XSS, clickjacking, MIME sniffing
# -----------------------------------------------------------------------------

<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Enable XSS protection in older browsers
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer policy — limit referrer leakage
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Basic Content Security Policy — adjust to your CDN/fonts as needed
    # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'none';"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://ajax.googleapis.com https://maxcdn.bootstrapcdn.com https://www.googletagmanager.com https://connect.facebook.net https://static.cloudflareinsights.com https://secure.trust-provider.com https://vigoe.ai; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://maxcdn.bootstrapcdn.com https://stackpath.bootstrapcdn.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com https://maxcdn.bootstrapcdn.com https://cdnjs.cloudflare.com data:; frame-src *; connect-src 'self' https://vigoe.ai; frame-ancestors 'self';"

    # Remove server version info
    Header always unset X-Powered-By
    Header always unset Server

    # Permissions policy — disable unnecessary browser APIs
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # HSTS — force HTTPS for 1 year (enable only if HTTPS is fully working)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# -----------------------------------------------------------------------------
# SECTION 6 — PREVENT PHP EXECUTION IN UPLOAD DIRECTORIES
# Critical: stops uploaded webshells from running even if one gets uploaded
# -----------------------------------------------------------------------------

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Use this block for upload, images, img directories
# Add a separate .htaccess inside each upload directory with:
#   php_flag engine off
#   Options -ExecCGI
#   AddType text/plain .php .phtml .phar .pl .cgi .sh

# -----------------------------------------------------------------------------
# SECTION 7 — REQUEST SIZE LIMITS
# Limits oversized POST bodies that could be used for DoS or file upload exploits
# -----------------------------------------------------------------------------

<IfModule mod_php.c>
    php_value upload_max_filesize 5M
    php_value post_max_size 8M
    php_value max_execution_time 30
    php_value max_input_time 30
    php_value memory_limit 128M
</IfModule>

LimitRequestBody 10485760

# -----------------------------------------------------------------------------
# SECTION 8 — CUSTOM ERROR PAGES
# Return minimal error responses — don't expose server/framework info in errors
# -----------------------------------------------------------------------------

ErrorDocument 400 /error/400.html
ErrorDocument 403 /error/403.html
ErrorDocument 404 /error/404.html
ErrorDocument 500 /error/500.html

# =============================================================================
# END OF FILE
# Review and update monthly. Log any changes with date and reason.
# =============================================================================

RewriteOptions inherit
RewriteEngine On

<IfModule mod_rewrite.c>
RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteCond %{HTTP_HOST} ^(.*)$  [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/cpanel-dcv/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/(?:\ Ballot169)?
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
    RewriteRule (.*) https://www.siet.ac.in/$1 [L,R=301]
</IfModule>

RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/cpanel-dcv/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/(?:\ Ballot169)?
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteRule ^/?(.*) https://%{SERVER_NAME}/$1 [R,L] 
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/cpanel-dcv/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/(?:\ Ballot169)?
RewriteRule ^(webportal|agrifest|media|kalam)($|/) - [L]
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/cpanel-dcv/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/(?:\ Ballot169)?
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^([^\.]+)$ $1.php [NC,L]

